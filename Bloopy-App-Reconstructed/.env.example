# Example ONLY. Do not overwrite an existing .env.local file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_KEY

# Claude API key required for app chat and on-demand visual analysis.
# Kept server-side, never expose through NEXT_PUBLIC_ fields.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
BLOOPY_AI_MODEL=claude-haiku-5-5
BLOOPY_ROBOT_BRIDGE_URL=http://127.0.0.1:8765

# Preserve your working NEXT_PUBLIC_APP_URL and Supabase redirect configuration.
# No OPENAI_API_KEY needed: speech recognition and TTS run locally.
